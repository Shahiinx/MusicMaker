FROM python:3.10

RUN apt-get update && apt-get upgrade -y
RUN apt-get install -y ffmpeg nodejs npm

WORKDIR /app

COPY . /app

RUN pip install --upgrade pip
RUN pip install pyrotgfork

RUN pip install pyromod --no-deps
RUN pip install py-tgcalls==0.9.7 --no-deps
RUN pip install -r requirements.txt

CMD ["python3", "main.py"]
