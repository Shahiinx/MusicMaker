FROM python:3.10

RUN apt-get update && apt-get upgrade -y
RUN apt-get install -y ffmpeg nodejs npm

WORKDIR /app

COPY . /app

RUN pip install --upgrade pip

RUN pip install pyrotgfork
RUN pip install pyromod
RUN pip install py-tgcalls==0.9.7
RUN pip install -r requirements.txt
RUN pip uninstall pyrogram


CMD ["python3", "main.py"]
